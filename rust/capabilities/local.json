{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-ui",
  "description": "Bundled UI: the navigation rail plus the settings and join-meeting windows.",
  "windows": [
    "settings",
    "join"
  ],
  "webviews": [
    "rail"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "allow-get-config",
    "allow-save-config",
    "allow-join-meeting",
    "allow-resource-usage",
    "allow-app-info",
    "allow-restart",
    "allow-open-external",
    "allow-open-window",
    "allow-switch-view",
    "allow-rail-state"
  ]
}
